# PostgreSQL connection string. Neon format:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth signing/encryption secret. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# Base URL of the deployed app. http://localhost:3000 in dev.
NEXTAUTH_URL="http://localhost:3000"

# Resend API key (https://resend.com). Leave empty in dev to use the console mail stub.
RESEND_API_KEY=""

# Sender address for outbound transactional emails.
EMAIL_FROM="noreply@yourdomain.com"

# Upstash Redis REST credentials (https://upstash.com). Leave empty in dev to use the noop limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SMTP (alternative to Resend for transactional email). Only needed if RESEND_API_KEY is empty.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_REJECT_UNAUTHORIZED="true"
